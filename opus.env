# The one place the version lives.
#
# `OPUS_SHA256` is checked before anything is unpacked, so a tarball that is not the
# one this repo was pinned to stops the build instead of silently becoming the
# artifact everything links against. Recompute it when bumping:
#
#   curl -sSLO https://downloads.xiph.org/releases/opus/opus-<version>.tar.gz
#   shasum -a 256 opus-<version>.tar.gz
#
# 1.6.1 rather than the 1.3-era copy vendored inside `audiopus_sys`, which is what
# every project was building until now — see README.md.
OPUS_VERSION=1.6.1
OPUS_SHA256=6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1

# Where the built archives are published. Read by sync-prebuilt.sh and by
# crates/libopus-prebuilt-sys/build.rs, so that a fork changes this in one place rather
# than in two scripts and a build script.
PREBUILT_REPO=andrewtheguy/libopus-prebuilt
